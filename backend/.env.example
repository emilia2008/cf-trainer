# Copy to .env for local development. Every value here is optional.

# Leave unset to use SQLite (./dev.db). postgres:// and postgresql:// URLs work as is.
# DATABASE_URL=postgresql+psycopg://cf:cf@localhost:5432/cf_trainer

# Frontend origins allowed to call the API, comma separated (no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Minimum seconds between Codeforces API calls (Codeforces allows about one every two seconds).
# CODEFORCES_MIN_INTERVAL_SECONDS=2.0
